    "deploy:one": "powershell -ExecutionPolicy Bypass -File ./scripts/netlify-one-click.ps1",
    "deploy:token": "powershell -ExecutionPolicy Bypass -File ./scripts/netlify-automated.ps1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
