{
  "name": "yinghuo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test",
    "build": "tsc -b && vite build",
    "build:gaokao3500": "node scripts/build-gaokao3500.mjs",
    "lint": "eslint .",
    "preview": "node server/index.mjs",
