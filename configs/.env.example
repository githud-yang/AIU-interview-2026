LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
YOLO_WEIGHTS=assets/models/best.pt
YOLO_CAMERA=0
# camera / demo / video
YOLO_SOURCE=camera
YOLO_CONF=0.25
# video source uses a local path configured on the server
YOLO_VIDEO=
YOLO_VIDEO_LOOP=0
# Optional cloud provider
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# Research writing/review: auto / codex / deepseek / openai / inherit
# auto: configured DeepSeek, configured OpenAI, existing Codex CLI, then controller.
RESEARCH_WRITER_PROVIDER=auto
RESEARCH_WRITER_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
# Set an explicit available API model when choosing openai.
OPENAI_MODEL=
OPENAI_API_KEY=
